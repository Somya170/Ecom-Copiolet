# Choose the LLM provider: "groq" or "openai"
LLM_PROVIDER=groq

# Required if LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database paths (defaults shown; overridden to /app/data/... inside Docker)
SQLITE_DB_PATH=ecommerce_oltp.db
DUCKDB_DB_PATH=ecommerce_analytics.duckdb
